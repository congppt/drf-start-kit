ENV=LOCAL
DB_URL=postgresql://postgres:postgres@localhost:5432/postgres?sslmode=prefer
# DB_URL=postgresql://user:pass@host:5432/dbname?sslmode=prefer
SECRET_KEY=a-random-key
# Required at import. ROOT_PASSWORD is base64 of the plaintext password, not a hash.
# The value below decodes to change-me. migrate creates this user and resets the password from here.
ROOT_USERNAME=root
ROOT_PASSWORD=Y2hhbmdlLW1l
MINIO__ENDPOINT=localhost:9000
MINIO__ACCESS_KEY=minioadmin
MINIO__SECRET_KEY=minioadmin
MINIO__PUBLIC_BUCKET=public
MINIO__PRIVATE_BUCKET=private
MINIO__PUBLIC_URL=http://localhost:9000
MINIO__SECURE=false
REDIS_URL=redis://localhost:6379
GUNICORN_WORKERS=4
HUEY_WORKERS=6
ALLOWED_HOSTS=
ALLOWED_ORIGINS=
LOG_RETENTION=60
FRONTEND_URL=http://localhost:3000
# Leave EMAIL__HOST empty in LOCAL to log emails to the console.
# EMAIL__HOST=smtp.example.com
# EMAIL__PORT=587
# EMAIL__HOST_USER=
# EMAIL__HOST_PASSWORD=
# EMAIL__USE_TLS=true
# EMAIL__FROM=noreply@example.com
